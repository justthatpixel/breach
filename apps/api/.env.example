DATABASE_URL=postgresql://breach:breach@localhost:5433/breach

EMBEDDING_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1/embeddings
EMBEDDING_MODEL=embo-01
EMBEDDING_DIM=1536

RETRIEVAL_TOP_K=5

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
JUDGE_TEMPERATURE=0
JUDGE_CONFIDENCE_THRESHOLD=0.6
LLM_TIMEOUT_SECONDS=20
LLM_RETRY_COUNT=1
LLM_INPUT_PRICE_PER_1K=0.003
LLM_OUTPUT_PRICE_PER_1K=0.015

MAX_NOTES_LENGTH=1000
RUN_RATE_LIMIT_PER_MINUTE=10
